import json

with open('/inputs/matrix.json', 'r', encoding='utf-8-sig') as f:
    matrix = json.load(f)

with open('/outputs/working/legal_propositions.json', 'r', encoding='utf-8-sig') as f:
    ledger = json.load(f)

# Enrich matrix propositions from the structured data
for i, item in enumerate(matrix):
    row = ledger['matrix'][i]
    num = item.get('number', '')
    enriched = item.get('enriched_text', '')
    main_idea = item.get('main_idea', '')
    topics = item.get('topics', [])
    req_type = item.get('required_type', '')
    product = item.get('only_for_product', 'common')
    lot = item.get('only_for_lot', 'common')
    terminal = item.get('only_for_terminal', 'common')
    payment = item.get('payment_method', 'common')
    
    # Determine type
    row['type'] = 'operative'
    
    # Determine materiality - most matrix items are evaluable
    row['materiality'] = 'evaluable'
    
    # Extract protected party - typically Bank for Bank rights, both for mutual
    text_lower = (enriched + ' ' + main_idea).lower()
    
    if any(w in text_lower for w in ['банк имеет право', 'банк вправе', 'право банка', 'банк может']):
        row['protected_party'] = 'Bank'
        row['bound_party'] = 'Merchant'
    elif any(w in text_lower for w in ['предприятие имеет право', 'предприятие вправе', 'заказчик вправе']):
        row['protected_party'] = 'Merchant'
        row['bound_party'] = 'Bank'
    elif any(w in text_lower for w in ['предприятие обязуется', 'предприятие обязано', 'заказчик обязуется']):
        row['protected_party'] = 'Bank'
        row['bound_party'] = 'Merchant'
    elif any(w in text_lower for w in ['банк обязуется', 'банк обязан', 'исполнитель обязуется']):
        row['protected_party'] = 'Merchant'
        row['bound_party'] = 'Bank'
    else:
        row['protected_party'] = 'Both'
        row['bound_party'] = 'Both'
    
    # Extract right_or_obligation
    if any(w in text_lower for w in ['банк имеет право', 'банк вправе', 'право банка', 'банк может']):
        row['right_or_obligation'] = 'Bank right'
    elif any(w in text_lower for w in ['предприятие имеет право', 'предприятие вправе', 'заказчик вправе']):
        row['right_or_obligation'] = 'Merchant right'
    elif any(w in text_lower for w in ['предприятие обязуется', 'предприятие обязано', 'заказчик обязуется']):
        row['right_or_obligation'] = 'Merchant duty'
    elif any(w in text_lower for w in ['банк обязуется', 'банк обязан', 'исполнитель обязуется']):
        row['right_or_obligation'] = 'Bank duty'
    else:
        row['right_or_obligation'] = 'Mutual obligation'
    
    # Extract legal object from topics
    if topics:
        row['legal_object'] = '; '.join(topics[:3])
    else:
        row['legal_object'] = main_idea[:200] if main_idea else enriched[:200]
    
    # Extract deadline
    import re
    deadlines = re.findall(r'(?:в течение|не позднее|не более|в срок|за)\s+[\d]+\s*(?:\([^)]+\))?\s*(?:рабочих|календарных)?\s*(?:дней|дня|часов|месяцев)', text_lower)
    if deadlines:
        row['deadline'] = deadlines[0]
    
    # Extract amounts
    amounts = re.findall(r'\d[\d\s]*\d*\s*(?:рублей|руб\.|процент)', text_lower)
    if amounts:
        row['amount_formula_cap'] = amounts[0] if len(amounts) == 1 else '; '.join(amounts[:3])
    
    # Set applicability filters
    row['applicability_filters'] = {
        'required_type': req_type,
        'only_for_product': product,
        'only_for_lot': lot,
        'only_for_terminal': terminal,
        'payment_method': payment
    }
    
    # Set consequence
    if 'отказать' in text_lower:
        row['consequence'] = 'Registration may be refused'
    elif 'штраф' in text_lower:
        row['consequence'] = 'Penalty/fine imposed'
    elif 'возместить' in text_lower or 'убытк' in text_lower:
        row['consequence'] = 'Indemnification/damages'
    elif 'расторж' in text_lower:
        row['consequence'] = 'Contract termination'
    elif 'удерж' in text_lower:
        row['consequence'] = 'Amount withheld from payments'
    
    # Set procedure_channel
    if 'электронн' in text_lower and 'почт' in text_lower:
        row['procedure_channel'] = 'Email'
    elif 'дбо' in text_lower:
        row['procedure_channel'] = 'DBO system'
    elif 'еис' in text_lower or 'единой информационной' in text_lower:
        row['procedure_channel'] = 'EIS'
    elif 'курьер' in text_lower or 'нарочн' in text_lower:
        row['procedure_channel'] = 'Courier/delivery'
    elif 'почтов' in text_lower:
        row['procedure_channel'] = 'Postal mail'
    
    # Set source_excerpt
    row['source_excerpt'] = main_idea[:240] if main_idea else enriched[:240]

with open('/outputs/working/legal_propositions.json', 'w', encoding='utf-8') as f:
    json.dump(ledger, f, ensure_ascii=False, indent=2)

print('Matrix propositions enriched:', len(ledger['matrix']))
# Count materiality
from collections import Counter
mat_counts = Counter(r['materiality'] for r in ledger['matrix'])
print('Matrix materiality:', dict(mat_counts))
"
