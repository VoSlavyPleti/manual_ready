for k in ['analysis_profile', 'links', 'atomic_links', 'unmatched_matrix', 'unmatched_contract', 'coverage_ledger', 'summary']:
    if k not in data:
        errors.append('Missing key: ' + k)

# Summary counts
s = data['summary']
aa = sum(1 for l in data['links'] if l['relationship'] == 'aligned')
ad = sum(1 for l in data['links'] if l['relationship'] == 'deviation')
am = len(data['unmatched_matrix'])
ae = len(data['unmatched_contract'])
if s['aligned_count'] != aa: errors.append('aligned_count mismatch')
if s['deviation_count'] != ad: errors.append('deviation_count mismatch')
if s['missing_in_contract_count'] != am: errors.append('missing_in_contract_count mismatch')
if s['extra_in_contract_count'] != ae: errors.append('extra_in_contract_count mismatch')

# Aligned consistency
for i, l in enumerate(data['links']):
    if l['relationship'] == 'aligned':
        if l.get('discrepancies') and len(l['discrepancies']) > 0:
            errors.append('Link %d aligned has discrepancies' % i)
        if l.get('risk_level') != 'none':
            errors.append('Link %d aligned risk not none' % i)

# Deviation consistency
for i, l in enumerate(data['links']):
    if l['relationship'] == 'deviation':
        if not l.get('discrepancies') or len(l['discrepancies']) == 0:
            errors.append('Link %d deviation no discrepancies' % i)
        if l.get('risk_level') == 'none':
            errors.append('Link %d deviation risk is none' % i)

# Unmatched matrix
for item in data['unmatched_matrix']:
    if not item.get('risk_level'): errors.append('UM %s no risk_level' % item['matrix_id'])
    if not item.get('risk'): errors.append('UM %s no risk' % item['matrix_id'])
    if item.get('status') != 'missing_in_contract': errors.append('UM %s wrong status' % item['matrix_id'])

# Unmatched contract
for item in data['unmatched_contract']:
    if not item.get('risk_level'): errors.append('UC %s no risk_level' % item['contract_id'])
    if not item.get('risk'): errors.append('UC %s no risk' % item['contract_id'])
    if not item.get('materiality_reason'): errors.append('UC %s no materiality_reason' % item['contract_id'])
    if item.get('status') != 'extra_in_contract': errors.append('UC %s wrong status' % item['contract_id'])

# Coverage ledger
clm = set(r['matrix_id'] for r in data['coverage_ledger']['matrix'])
with open('/inputs/matrix.json', 'r', encoding='utf-8-sig') as f:
    allm = set(item['number'] for item in json.load(f))
missing = allm - clm
if missing: errors.append('Ledger missing: %s' % sorted(missing)[:5])

# OOS check
for item in data['unmatched_matrix']:
    for c in data['coverage_ledger']['matrix']:
        if c['matrix_id'] == item['matrix_id'] and c['closure'] in ('out_of_scope', 'not_applicable'):
            errors.append('OOS in unmatched: ' + item['matrix_id'])

# Risk distribution
lr = Counter(l['risk_level'] for l in data['links'])
ur = Counter(i['risk_level'] for i in data['unmatched_matrix'])
cr = Counter(i['risk_level'] for i in data['unmatched_contract'])

print('Errors: %d' % len(errors))
for e in errors[:20]:
    print('  ' + e)
if len(errors) > 20:
    print('  ... and %d more' % (len(errors) - 20))
print('Link risks: %s' % dict(lr))
print('Missing risks: %s' % dict(ur))
print('Extra risks: %s' % dict(cr))
print('Coverage ledger: %d/%d matrix ids' % (len(clm), len(allm)))
print('Links: %d (aligned=%d, deviation=%d)' % (len(data['links']), aa, ad))
print('Unmatched: matrix=%d, contract=%d' % (am, ae))
print('Atomic links: %d' % len(data.get('atomic_links', [])))
if errors:
    print('VALIDATION FAILED')
else:
    print('VALIDATION PASSED')
